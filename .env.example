NODE_ENV=development
PORT=3000
DEMO_MODE=false
DEMO_SEED_ENABLED=false

# Use DATABASE_URL for hosted PostgreSQL, or the DB_* values below.
DATABASE_URL=
DATABASE_SSL=false
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=datos_empleados_db

# Generate a private random value with at least 32 characters.
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
